<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.privatevoice.app">

    <!-- Deliberately NOT requested: INTERNET, RECORD_AUDIO, READ_CONTACTS, RECEIVE_SMS,
         BIND_ACCESSIBILITY_SERVICE. Message reading uses notification access only. -->

    <!-- Read-aloud / Stop controls notification (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional floating button; requested only when the user enables it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional "Text Messages" history: requested at runtime only when the user turns it on. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Short-lived playback service while a message is being read (needed for audio focus on Android 15+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Lets the user exempt the app from battery optimization (opt-in, for reliable automatic reading). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility: only to show messaging app names. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.whatsapp" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.google.android.apps.dynamite" />
        <package android:name="com.discord" />
        <package android:name="com.Slack" />
    </queries>

    <application
        android:name=".PrivateVoiceApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PrivateVoice"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification listener: exported only to the system via BIND_NOTIFICATION_LISTENER_SERVICE. -->
        <service
            android:name=".notifications.PrivateVoiceListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>

        <!-- Quick Settings tile: exported only to the system via BIND_QUICK_SETTINGS_TILE. -->
        <service
            android:name=".tile.ReadLatestTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_voice"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".reader.ReadingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".notifications.ReaderActionReceiver"
            android:exported="false" />
    </application>
</manifest>
