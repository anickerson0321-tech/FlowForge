<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: history and dictionary are encrypted with a key that
     never leaves this device's Keystore, and dictated content should not be copied to the cloud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
